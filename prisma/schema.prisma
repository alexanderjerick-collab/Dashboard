generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  STAFF
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum LicenseTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum LicenseStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum AuditAction {
  PROMOTE
  DEMOTE
  EXILE
  ACCEPT_REQUEST
  REJECT_REQUEST
  USER_CREATED
  USER_DELETED
  API_KEY_CREATED
  API_KEY_REVOKED
  GROUP_LINKED
  GROUP_UNLINKED
  LICENSE_UPDATED
  PERMISSION_UPDATED
  LOGIN
  LOGOUT
  RANK_CREATED
  RANK_UPDATED
  RANK_DELETED
  WARNING_ISSUED
  NOTE_ADDED
  SCHEDULED_RANK
  BULK_PROMOTE
  BULK_DEMOTE
}

model User {
  id               String     @id @default(cuid())
  username         String     @unique
  email            String     @unique
  passwordHash     String
  role             UserRole   @default(STAFF)
  status           UserStatus @default(ACTIVE)
  twoFactorEnabled Boolean    @default(false)
  twoFactorSecret  String?
  lastLoginAt      DateTime?
  lastLoginIp      String?
  robloxUserId     String?
  robloxUsername   String?
  robloxAvatarUrl  String?
  robloxCookie     String?
  permissionId     String?
  permission       Permission?    @relation(fields: [permissionId], references: [id])
  apiKeys          ApiKey[]
  auditLogs        AuditLog[]
  sessions         Session[]
  warnings         Warning[]      @relation("WarnedUser")
  warningsGiven    Warning[]      @relation("WarnedBy")
  staffNotes       StaffNote[]    @relation("NoteTarget")
  notesCreated     StaffNote[]    @relation("NoteAuthor")
  scheduledRanks   ScheduledRank[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("sessions")
}

model Permission {
  id                String   @id @default(cuid())
  name              String   @unique
  description       String?
  level             Int      @default(0)
  canPromote        Boolean  @default(false)
  canDemote         Boolean  @default(false)
  canExile          Boolean  @default(false)
  canAcceptReqs     Boolean  @default(false)
  canRejectReqs     Boolean  @default(false)
  canEditPerms      Boolean  @default(false)
  canCreateUsers    Boolean  @default(false)
  canDeleteUsers    Boolean  @default(false)
  canCreateApiKeys  Boolean  @default(false)
  canViewLogs       Boolean  @default(false)
  canViewAnalytics  Boolean  @default(false)
  canManageLicenses Boolean  @default(false)
  canManageBilling  Boolean  @default(false)
  users             User[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("permissions")
}

model Group {
  id            String   @id @default(cuid())
  robloxGroupId String   @unique
  name          String
  description   String?
  memberCount   Int      @default(0)
  ownerRobloxId String?
  thumbnailUrl  String?
  isVerified    Boolean  @default(false)
  isActive      Boolean  @default(true)
  auditLogs     AuditLog[]
  scheduledRanks ScheduledRank[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("groups")
}

model License {
  id                 String        @id @default(cuid())
  tier               LicenseTier   @default(STARTER)
  status             LicenseStatus @default(ACTIVE)
  maxGroups          Int           @default(1)
  maxStaff           Int           @default(5)
  hasAnalytics       Boolean       @default(false)
  hasWebhooks        Boolean       @default(false)
  hasCustomBranding  Boolean       @default(false)
  apiRateLimit       Int           @default(100)
  expiresAt          DateTime?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("licenses")
}

model ApiKey {
  id             String       @id @default(cuid())
  name           String
  keyHash        String       @unique
  keyPrefix      String
  status         ApiKeyStatus @default(ACTIVE)
  permissions    Json         @default("{}")
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  lastUsedIp     String?
  usageCount     Int          @default(0)
  rateLimit      Int          @default(100)
  ipRestrictions String[]
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs      AuditLog[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("api_keys")
}

model AuditLog {
  id             String      @id @default(cuid())
  action         AuditAction
  actorId        String?
  actor          User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  apiKeyId       String?
  apiKey         ApiKey?     @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  groupId        String?
  group          Group?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  targetUserId   String?
  targetUsername String?
  details        Json        @default("{}")
  ip             String?
  createdAt      DateTime    @default(now())

  @@map("audit_logs")
}

model Warning {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("WarnedUser", fields: [userId], references: [id], onDelete: Cascade)
  issuedById String
  issuedBy   User     @relation("WarnedBy", fields: [issuedById], references: [id])
  reason     String
  createdAt  DateTime @default(now())

  @@map("warnings")
}

model StaffNote {
  id        String   @id @default(cuid())
  targetId  String
  target    User     @relation("NoteTarget", fields: [targetId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("NoteAuthor", fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@map("staff_notes")
}

model ScheduledRank {
  id           String    @id @default(cuid())
  groupId      String
  group        Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  robloxUserId String
  targetRank   Int
  scheduledFor DateTime
  executed     Boolean   @default(false)
  executedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@map("scheduled_ranks")
}

model Webhook {
  id         String    @id @default(cuid())
  name       String
  url        String
  events     String[]
  isActive   Boolean   @default(true)
  secret     String?
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("webhooks")
}
